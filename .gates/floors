# What this repository's gates cover, declared by this repository.
#
# Every gate already refuses to pass on a zero denominator. This file catches
# the other direction: a gate that still runs but examines LESS than it used
# to, or one that decides the repository is out of scope entirely and returns
# "not applicable" -- which the CI adapter maps to success, because for an
# orchestrator there is no third state.
#
# Floors are minimums with deliberate headroom. A floor set to today's exact
# count goes red on the next commit that deletes a file for a good reason, and
# a check that cries wolf gets removed. These sit below current values and are
# raised when the gap stops being informative.
#
# n/a is a positive declaration that a gate does not apply here, not a way to
# opt out of one that does. A gate with no entry at all is an error.

# Markdown files carrying claims the docs gate verifies.
docs=3

# gradle-wrapper.jar, gradlew, gradlew.bat, and the distribution checksum.
gradle-wrapper=4

# Tests actually executed, not declared. Currently 85.
jvm-test=60

# Commits in the scanned range. Grows with history; floor is a lower bound.
secrets=15

# Shell files. This is a JVM project, so the count is small and stable.
shellcheck=1
